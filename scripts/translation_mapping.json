   ]
  }
 ],
 "not_translated": {
  "oil_classified.breached_essays": "Structured JSON of essay names/values; names are translated at display time (vocab).",
  "oil_machine_status.component_details": "Nested struct list; only read by Overview, not by the Oil tabs.",
  "unit_failure_analisis.observaciones": "Not rendered by the dashboard (Evidence builds its own observations from data).",
  "unit_failure_analisis.limitacion / mode_failure_analisis.limitation": "Not rendered by the dashboard.",
  "unit_failure_analisis.modos_ordenados": "JSON of mode -> score, no prose.",
  "Predictive > General": "Renders no long text column (state, ranking, curves only).",
  "Telemetry > numeric health tables": "unit_health, system_health, deviation/trend/event results hold scores and names only, no prose."
